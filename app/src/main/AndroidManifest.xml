<!-- AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.valetparking">

    <!-- Izin Kamera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Izin Penyimpanan untuk Android di bawah API 29 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.ValetParking">

        <!-- Deklarasi MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"> <!-- or "false" based on your need -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Deklarasi AddVehicleActivity -->
        <activity android:name=".AddVehicleActivity" />

        <!-- Deklarasi FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
