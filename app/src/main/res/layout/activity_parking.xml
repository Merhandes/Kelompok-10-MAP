<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#333333">

    <!-- Title -->
    <TextView
        android:id="@+id/title_parking_spot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parking Spot"
        android:textSize="24sp"
        android:textColor="#FFFFFF" />

    <!-- Grid Layout for Parking Spots -->
    <GridLayout
        android:id="@+id/grid_parking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="4"
        android:padding="16dp"
        android:layout_gravity="center">

        <!-- Parking Slots, add 6 buttons for the 6 spots -->
        <!-- Example for Slot 1 -->
        <Button
            android:id="@+id/slot1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />

        <Button
            android:id="@+id/slot2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />
        <Button
            android:id="@+id/slot9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#000000" />

        <!-- Other slots similarly (slot2, slot3, ..., slot6) -->

    </GridLayout>

    <!-- Date and Time -->
    <TextView
        android:id="@+id/tv_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="08/10/2024 - 21:04"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_gravity="center" />
</LinearLayout>
