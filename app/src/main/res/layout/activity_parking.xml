<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="#FFDDDDDD">

    <!-- Left side parking slots (5 slots) -->
    <LinearLayout
        android:id="@+id/left_parking_slots"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Slot 1 -->
        <ImageView
            android:id="@+id/slot_1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 1" />

        <!-- Slot 2 -->
        <ImageView
            android:id="@+id/slot_2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 2" />

        <!-- Slot 3 -->
        <ImageView
            android:id="@+id/slot_3"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 3" />

        <!-- Slot 4 -->
        <ImageView
            android:id="@+id/slot_4"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 4" />

        <!-- Slot 5 -->
        <ImageView
            android:id="@+id/slot_5"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 5" />

    </LinearLayout>

    <!-- Center area for Add/Edit buttons -->
    <LinearLayout
        android:id="@+id/middle_buttons"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Add/Edit Button 1 -->
        <Button
            android:id="@+id/button_add_edit_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <!-- Add/Edit Button 2 -->
        <Button
            android:id="@+id/button_add_edit_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <!-- Add/Edit Button 3 -->
        <Button
            android:id="@+id/button_add_edit_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <!-- Add/Edit Button 4 -->
        <Button
            android:id="@+id/button_add_edit_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <!-- Add/Edit Button 5 -->
        <Button
            android:id="@+id/button_add_edit_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/button_add_edit_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/button_add_edit_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/button_add_edit_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/button_add_edit_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />
        <Button
            android:id="@+id/button_add_edit_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add/Edit"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

    <!-- Right side parking slots (5 slots) -->
    <LinearLayout
        android:id="@+id/right_parking_slots"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Slot 6 -->
        <ImageView
            android:id="@+id/slot_6"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 6" />

        <!-- Slot 7 -->
        <ImageView
            android:id="@+id/slot_7"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 7" />

        <!-- Slot 8 -->
        <ImageView
            android:id="@+id/slot_8"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 8" />

        <!-- Slot 9 -->
        <ImageView
            android:id="@+id/slot_9"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 9" />

        <!-- Slot 10 -->
        <ImageView
            android:id="@+id/slot_10"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/parking_slot"
            android:contentDescription="Parking Slot 10" />

    </LinearLayout>

</LinearLayout>
