<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:background="#333333">

    <!-- Title -->
    <TextView
        android:id="@+id/title_add_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD/EDIT"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Plate Number Field -->
    <EditText
        android:id="@+id/et_plate_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Plate Number"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/border_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_add_edit" />

    <!-- Color Field -->
    <EditText
        android:id="@+id/et_color"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Car Color"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/border_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_plate_number" />

    <!-- Insert Photo Button -->
    <Button
        android:id="@+id/btn_insert_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="Insert Photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_color" />

    <!-- ImageView to Display Photo -->
    <ImageView
        android:id="@+id/img_view"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/border_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_insert_photo" />

    <!-- Date and Time -->
    <TextView
        android:id="@+id/tv_date_time_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="252dp"
        android:minHeight="48dp"
        android:text="08/10/2024 - 21:04"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_insert_photo" />

</androidx.constraintlayout.widget.ConstraintLayout>
