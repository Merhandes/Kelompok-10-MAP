<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/greetingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Good Luck Today"
        android:textColor="#000"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/parkingSpotText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/parkingSpotText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="Parking Spot"
        android:textColor="#000"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greetingText" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/qrButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/parkingSpotText"
        app:layout_constraintVertical_bias="0.209">

        <Button
            android:id="@+id/decrementButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/circle_button"
            android:backgroundTint="@color/black"
            android:gravity="center"
            android:padding="0dp"
            android:text="-"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/spotNumber"
            android:layout_width="197dp"
            android:layout_height="104dp"
            android:layout_margin="20dp"
            android:background="@drawable/border"
            android:gravity="center"
            android:padding="15dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/incrementButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/circle_button"
            android:gravity="center"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/qrButton"
        android:layout_width="311dp"
        android:layout_height="60dp"
        android:background="@drawable/button_custom1"
        android:text="QR"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintVertical_bias="0.323" />

</androidx.constraintlayout.widget.ConstraintLayout>
